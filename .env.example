# Copy to .env and fill in. Everything without VITE_ stays server-side.

# ── SANITY ──
VITE_SANITY_PROJECT_ID=xbjigamf
VITE_SANITY_DATASET=production
NETLIFY_SANITY_PROJECT_ID=xbjigamf        # server-side read proxy
SANITY_WRITE_TOKEN=                        # Editor token (sanity tokens add)

# ── AUTH0 ──
VITE_AUTH0_DOMAIN=                         # e.g. your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=                      # SPA application client id
AUTH0_DOMAIN=                              # same value, for the functions
AUTH0_CLIENT_ID=                           # same value, for the functions
AUTH0_ALLOWED_EMAILS=                      # optional: comma-separated allowlist

# ── STRIPE ──
STRIPE_CONFIG=                             # JSON {"secretKey":"","publishableKey":"","webhookSecret":""}
STRIPE_CUSTOMER_ID=                        # cus_… primary: subscription, card, portal
STRIPE_LEGACY_CUSTOMER_IDS=                # optional cus_…,cus_… older records, history only

# ── ANALYTICS ──
SIMPLE_ANALYTICS_API_KEY=
ANALYTICS_HOSTNAME=                        # site the dashboard reports on

# ── SUPPORT EMAIL (Resend) ──
RESEND_API_KEY=
CONTACT_TO_EMAIL=                          # where support requests land
CONTACT_FROM_EMAIL=                        # verified Resend sender
SUPPORT_WEBHOOK_URL=                       # optional: forward requests to the /requests queue
SUPPORT_WEBHOOK_TOKEN=                     # optional: bearer token that queue expects

# ── PIPELINE DASHBOARD (offline invoices: Zelle/check) ──
PIPELINE_API_URL=                          # https://<pipeline>/.netlify/functions
PIPELINE_API_TOKEN=                        # service credential the Pipeline verifies
PIPELINE_CLIENT_ID=                        # this client's id in the Pipeline database

# ── NETLIFY ──
NETLIFY_SITE_ID=                           # this dashboard's site id
